# Deployment configuration; copied to .env and never committed with secrets.
HOST=127.0.0.1
PORT=4173
RENDER_PORT=8090
RENDER_SERVICE_URL=http://127.0.0.1:8090
# Optional separate CPU authoring API; empty uses the combined renderer API.
AUTHORING_SERVICE_URL=
CHRONA_DATA_DIR=.data
# Optional independent uv environment, e.g. .venv-inference
UV_PROJECT_ENVIRONMENT=.venv
# Unified renderer, using local MiniMax-H3 Ref2VA weights by default.
DW_VIDEO_PROVIDER=chrona.adapters.providers.local_reference:LocalReferenceRenderer
# Local model implementation and weights (used only by LocalReferenceRenderer).
DW_PROVIDER=chrona.adapters.providers.minimax:ReferenceRenderer
DW_MODEL_PATH=
# Immutable model revision when available; file/config fingerprints are also recorded.
DW_MODEL_REVISION=
DW_LORA_DIR=
DW_DEVICE=cuda:0
DW_MEMORY_RESERVE=18GB
DW_ATTENTION_BACKEND=native
DW_PRELOAD=false
DW_UPLOAD_LIMIT_MB=1024
DW_METADATA_LIMIT_MB=64
DW_OBSERVATION_LIMIT=500000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# Backward-compatible provider setting when DW_VIDEO_PROVIDER is empty.
DW_CONTINUOUS_PROVIDER=chrona.adapters.providers.local_reference:LocalReferenceRenderer
DW_VIDEO_SERVICE_URL=http://127.0.0.1:8088
DW_VIDEO_PROFILE=
DW_VIDEO_SERVICE_TOKEN=
# Optional official prompt enhancement. The per-video switch defaults to off.
DW_PROMPT_ENHANCEMENT_ENABLED=false
DW_PROMPT_ENHANCEMENT_BASE_URL=https://api.minimax.cn
DW_PROMPT_ENHANCEMENT_MODEL=MiniMax-H3
DW_PROMPT_ENHANCEMENT_API_KEY=
DW_PROMPT_ENHANCEMENT_TIMEOUT_SECONDS=300
DW_PROMPT_ENHANCEMENT_POLL_SECONDS=3
CONTENT_DATA_DIR=.data/content
# Code agent: empty URL/model retains the offline demo. UI-saved settings take precedence.
DW_AGENT_ENABLED=true
DW_AGENT_BASE_URL=
DW_AGENT_MODEL=
DW_AGENT_API_KEY=
DW_AGENT_TIMEOUT_SECONDS=180
DW_AGENT_MAX_ROUNDS=8
DW_AGENT_WORLD_URL=http://127.0.0.1:4173
DW_AGENT_BROWSER_ORIGIN=http://127.0.0.1:4173
# Optional owner token (24+ characters); otherwise generated privately on the server.
DW_AGENT_ACCESS_TOKEN=
