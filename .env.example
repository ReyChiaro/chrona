# Deployment configuration; copied to .env and never committed with secrets.
HOST=127.0.0.1
PORT=4173
RENDER_PORT=8090
RENDER_SERVICE_URL=http://127.0.0.1:8090
# Optional separate CPU authoring API; empty uses the combined renderer API.
AUTHORING_SERVICE_URL=
CHRONA_DATA_DIR=.data
# Optional independent uv environment, e.g. .venv-inference
UV_PROJECT_ENVIRONMENT=.venv
# Unified renderer, using local MiniMax-H3 Ref2VA weights by default.
CHRONA_VIDEO_PROVIDER=chrona.adapters.providers.local_reference:LocalReferenceRenderer
# Local model implementation and weights (used only by LocalReferenceRenderer).
CHRONA_PROVIDER=chrona.adapters.providers.minimax:ReferenceRenderer
CHRONA_MODEL_PATH=
# Immutable model revision when available; file/config fingerprints are also recorded.
CHRONA_MODEL_REVISION=
CHRONA_LORA_DIR=
CHRONA_DEVICE=cuda:0
CHRONA_MEMORY_RESERVE=18GB
CHRONA_ATTENTION_BACKEND=native
CHRONA_PRELOAD=false
CHRONA_UPLOAD_LIMIT_MB=1024
CHRONA_METADATA_LIMIT_MB=64
CHRONA_OBSERVATION_LIMIT=500000
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
CHRONA_VIDEO_SERVICE_URL=http://127.0.0.1:8088
CHRONA_VIDEO_PROFILE=
CHRONA_VIDEO_SERVICE_TOKEN=
# Optional official prompt enhancement. The per-video switch defaults to off.
CHRONA_PROMPT_ENHANCEMENT_ENABLED=false
CHRONA_PROMPT_ENHANCEMENT_BASE_URL=https://api.minimax.cn
CHRONA_PROMPT_ENHANCEMENT_MODEL=MiniMax-H3
CHRONA_PROMPT_ENHANCEMENT_API_KEY=
CHRONA_PROMPT_ENHANCEMENT_TIMEOUT_SECONDS=300
CHRONA_PROMPT_ENHANCEMENT_POLL_SECONDS=3
CONTENT_DATA_DIR=.data/content
# Code agent: configure URL and model before use. UI-saved settings take precedence.
CHRONA_AGENT_ENABLED=true
CHRONA_AGENT_BASE_URL=
CHRONA_AGENT_MODEL=
CHRONA_AGENT_API_KEY=
CHRONA_AGENT_TIMEOUT_SECONDS=180
CHRONA_AGENT_MAX_ROUNDS=8
CHRONA_AGENT_WORLD_URL=http://127.0.0.1:4173
CHRONA_AGENT_BROWSER_ORIGIN=http://127.0.0.1:4173
# Optional owner token (24+ characters); otherwise generated privately on the server.
CHRONA_AGENT_ACCESS_TOKEN=
